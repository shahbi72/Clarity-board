# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clarityboard_reports

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
ENABLE_CREDENTIALS_AUTH=0

# Google OAuth (Web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token encryption (32-byte key, base64 or 64-char hex)
TOKEN_ENC_KEY=

# Reports cron auth
CRON_SECRET=replace-with-random-cron-secret

# Paddle billing (single source of truth)
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_BASIC_ID=pri_
NEXT_PUBLIC_PADDLE_PRICE_PRO_ID=pri_
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_ID=pri_
NEXT_PUBLIC_PADDLE_MANAGEMENT_URL=

# Email delivery
RESEND_API_KEY=
REPORTS_FROM_EMAIL=Clarityboard Reports <reports@clarityboard.app>

# Optional local demo auth for e2e/dev
REPORTS_DEMO_AUTH=0
NEXT_PUBLIC_REPORTS_DEMO_AUTH=0
REPORTS_DEMO_USER_ID=reports-demo-user
REPORTS_DEMO_USER_EMAIL=demo@clarityboard.local

# Legacy Supabase auth variables (existing app modules)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
