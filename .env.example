# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres)
# Runtime (pooler / PgBouncer in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/clarityboard?sslmode=require&pgbouncer=true&connection_limit=1
# Migrations (direct Postgres connection, no PgBouncer)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/clarityboard?sslmode=require
# Prisma + PgBouncer compatibility
PRISMA_DISABLE_POSTGRESQL_PREPARED_STATEMENTS=true

# Supabase auth (required for login/signup)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local fallback user (for local development without Supabase auth)
DEMO_USER_ID=demo-user

# Paddle billing (single source of truth)
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_BASIC_ID=pri_
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_ID=pri_
NEXT_PUBLIC_PADDLE_MANAGEMENT_URL=

# Google Sheets live sync (Business plan)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background jobs + secure token encryption
CRON_SECRET=
TOKEN_ENC_KEY=
